# Copy to .env in drone-vision/. Keep this file at the project root.
MODEL_PATH=
DEVICE=auto
CONFIDENCE_THRESHOLD=0.60
IOU_THRESHOLD=0.45
# Empty MODEL_PATH is intentional: Demo mode works without weights.
# Set MODEL_PATH=drone_detector.pt after installing trusted weights in backend/models.
# SQLite is the automatic default. To override:
# DATABASE_URL=sqlite:///./dronevision.db
# DATABASE_URL=postgresql+psycopg://dronevision:password@localhost:5432/dronevision
# Absolute overrides are supported for DATA_DIR and MODEL_DIR.
MAX_UPLOAD_MB=500
MAX_MODEL_MB=250
MAX_SESSION_FRAMES=100000
MAX_RECORDING_MB=2048
MAX_FRAME_BYTES=2000000
TELEMETRY_TTL_SECONDS=5
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
ALLOW_PT_UPLOAD=false
ENABLE_RTSP=false
RTSP_ALLOWED_HOSTS=
# Docker PostgreSQL development password; change before remote deployment.
POSTGRES_PASSWORD=local_dronevision_change_me
# Vite defaults to the same-origin development proxy. These are optional.
# Put frontend overrides in frontend/.env.local, not this root file:
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000/ws/tracking
